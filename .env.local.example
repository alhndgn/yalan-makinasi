# AI sunucusu — derleme zamanında uygulamanın içine gömülür (kullanıcı ayar görmez).
# Bu dosyayı ".env.local" olarak kopyala ve gerçek değerleri yaz; .env.local git'e girmez.
#
# bulut (opencode-go / yelsoft proxy):
VITE_AI_BASE_URL=https://api.yelsoft.online/v1
VITE_AI_MODEL=ollamacloud/deepseek-v4.1-flash
VITE_AI_KEY=BURAYA_ANAHTAR

# yerel VM kullanacaksan bunun yerine:
# VITE_AI_BASE_URL=http://192.168.1.12/ai/v1
# VITE_AI_MODEL=qwen2.5:14b-instruct-q4_K_M
# VITE_AI_KEY=
